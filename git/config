  email = conor@sketch.com
  name = c-brenn
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHdJQdQ/0shwkvf+YgY2dFM4+yFkW6FREn458W4tV6ZT
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
